(type Point {x: float, y: float, label: string?})
(fn clamp(value: int, low: int, high: int) -> int
  (block
    (if
      (< value low)
      (block low)
      (if (> value high) (block high) (block value)))))
(fn area(width: float, height: float) -> float (block (* width height)))
