(let t (call from_rows (list (record (a: 1)))))
(call print t (rows: "3"))
(call print t (rows: (- 1)))
(call print (rows: 3) t)
(call print t (limit: 3))
(call to_markdown)
(call to_markdown t 5)
(call to_markdown "text")
(call to_html t (title: "x"))
(call write_markdown t)
(call write_html t "a.html" "title")
(call write_markdown "a.md" t)
(let text: int (call to_markdown t))
