(type Visit {day: date, site: string, visits: int?, open: bool})
(let log (call read_csv <Visit> "visits.csv"))
(|> log (call window (a: (call dense_rank visits))))
(|> log (call window (a: (call percent_rank 1))))
(|> log (call window (a: (call ntile))))
(|> log (call window (a: (call ntile 0))))
(|> log (call window (a: (call ntile visits))))
(|> log (call window (a: (call ntile 2 3))))
(|> log (call window (a: (call cum_count visits 2))))
(|> log (call window (a: (call cum_min))))
(|> log (call window (a: (call cum_max open))))
(|> log (call window (a: (call cum_mean site))))
(|> log (call window (a: (call moving_sum visits))))
(|> log (call window (a: (call moving_sum site 2))))
(|> log (call window (a: (call moving_min visits 0))))
(|> log (call window (a: (call moving_max visits visits))))
(|> log (call window (a: (call diff site))))
(|> log (call window (a: (call diff visits 1.5))))
(|> log (call window (a: (call pct_change day))))
(|> log (call window (a: (call pct_change))))
(|> log (call window (a: (call fill_forward))))
(|> log (call window (a: (call fill_backward visits 1))))
(|> log (call derive (a: (call diff visits))))
(|> log (call agg (a: (call cum_max visits))))
(call diff 1)
