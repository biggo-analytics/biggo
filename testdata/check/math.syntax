(type Sale {region: string, qty: int, price: float?})
(let sales (call read_csv <Sale> "sales.csv"))
(let names (list "a" "b"))
(in 1 2)
(in 1 (list "a"))
(in "a" (list 1 2))
(in null (list 1))
(in 1.5 names)
(in (list 1) (list (list 1)))
(|> sales (call where (in region qty)))
(|> sales (call where (in qty (list region))))
(|> sales (call where (in region sales)))
(call pow 2)
(call pow "2" 2)
(call exp)
(call ln "e")
(call log 8)
(call sign "x")
(call div 7 2.0)
(call div 7)
(call trunc 2.5 1.5)
(call trunc 1 2 3)
(|> sales (call derive (t: (call trunc price qty))))
(call is_nan "x")
(call pi 1)
(call sin @2026-01-01)
(call greatest 1)
(call greatest 1 "a")
(call least true false)
(call greatest null 1)
(call greatest (list 1) (list 2))
(call null_if 1)
(call null_if 1 "a")
(call null_if (list 1) (list 1))
(call try_to_int @2026-01-01)
(call try_to_date 5)
(call to_bool 1.5)
(call try_to_bool @2026-01-01)
(call parse_number 5)
(call between 1 2)
(call between 1 "a" "b")
(call clamp 1 2)
(call clamp 1 "a" 3)
