// Mistakes in the newer string functions.
type Sale = { region: string, qty: int, price: float? }
let sales = read_csv<Sale>("sales.csv")

format_number(1)
format_number("1", 2)
format_number(1, 2.5)
format_number(1, -1)
format_number(1, 16)
format_number(1, 2, 3)
format_number(1, 2, ",", ".")
sales |> derive(a = format_number(price, qty))
sales |> derive(a = format_number(price, 2, region))
format_percent("half")
format_percent(0.5, 99)
trim_left()
trim_left(1)
trim("a", 1)
trim("a", "b", "c")
left("abc")
left("abc", "2")
right(5, 2)
repeat("a")
repeat("a", 1.5)
reverse(123)
title()
concat()
concat([1])
concat(sales)
like("abc")
like("abc", 5)
like("abc", "oops\\")
sales |> where(like(region, region))
regex_count("abc")
regex_count("abc", "a(")
sales |> derive(n = regex_count(region, region))
sha256(1)
md5()
