(type Event {day: date, at: datetime, text: string, n: int})
(let events (call read_csv <Event> "events.csv"))
(call today 1)
(call now "x")
(call weekday "monday")
(call weekday 1)
(call quarter)
(call start_of_month 5)
(call add_days @2026-01-01 1.5)
(call add_months @2026-01-01)
(call add_years "2026" 1)
(call days_between @2026-01-01 5)
(call months_between @2026-01-01)
(call total_days 5)
(call total_hours @2026-01-01)
(call make_date 2026 1)
(call make_date 2026 "1" 1)
(call make_datetime 2026 1 1)
(call format_date @2026-01-01)
(call format_date @2026-01-01 "%Q")
(call format_date @2026-01-01 "%Y %Z")
(call format_date "2026-01-01" "%Y")
(call format_date @2026-01-01 "%Y" (era: "be"))
(call format_date @2026-01-01 "%Y" (calendar: "buddhist"))
(call format_date @2026-01-01 "%Y" "buddhist")
(call parse_date "2026" 2026)
(call parse_date 2026 "%Y")
(call parse_datetime "2026")
(call try_parse_date "2026" "%")
(|> events (call derive (shown: (call format_date day text))))
(|> events (call derive (read: (call parse_date text "%Y" (era: text)))))
(call time_bucket @2026-01-01 15)
(call time_bucket "2026" (call minutes 15))
(call to_unix 5)
(call from_unix "5")
(call fiscal_year @2026-01-01)
(call fiscal_year @2026-01-01 "10")
(call buddhist_year 2569)
(call weekday @2026-01-01 (era: "buddhist"))
