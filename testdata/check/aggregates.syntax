(type Sale {region: string, qty: int, price: float?, sold: bool})
(let sales (call read_csv <Sale> "sales.csv"))
(|> sales (call agg (a: (call quantile qty))))
(|> sales (call agg (a: (call quantile qty 1.5))))
(|> sales (call agg (a: (call quantile qty (- 0.1)))))
(|> sales (call agg (a: (call quantile qty "half"))))
(|> sales (call agg (a: (call quantile qty price))))
(|> sales (call agg (a: (call quantile region 0.5))))
(|> sales (call agg (a: (call quantile qty 0.5 0.9))))
(|> sales (call agg (a: (call variance region))))
(|> sales (call agg (a: (call stddev_pop sold))))
(|> sales (call agg (a: (call product region))))
(|> sales (call agg (a: (call string_agg region))))
(|> sales (call agg (a: (call string_agg qty ","))))
(|> sales (call agg (a: (call string_agg region 1))))
(|> sales (call agg (a: (call string_agg region region))))
(|> sales (call agg (a: (call arg_max region))))
(|> sales (call agg (a: (call arg_max region sold))))
(|> sales (call agg (a: (call arg_min region qty price))))
(|> sales (call agg (a: (call count_if qty))))
(|> sales (call agg (a: (call count_if))))
(|> sales (call agg (a: (call count_if sold sold))))
(|> sales (call agg (a: (call any region))))
(|> sales (call agg (a: (call all (+ qty 1)))))
(|> sales (call agg (a: (call count_null))))
(|> sales (call agg (a: (call weighted_mean price))))
(|> sales (call agg (a: (call weighted_mean price region))))
(|> sales (call agg (a: (call weighted_mean region qty))))
(|> sales (call derive (a: (call count_if sold))))
(|> sales (call where (call any sold)))
(|> sales (call window (a: (call quantile qty 0.5))))
(|> sales (call window (a: (call string_agg region ","))))
(|> sales (call window (a: (call arg_max region qty))))
(call count_if true)
(call variance 1)
