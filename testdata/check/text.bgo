// Mistakes in string functions, regular expressions, program arguments and CSV options.
type Sale = { region: string, qty: int, note: string? }
let sales = read_csv<Sale>("sales.csv")

substring("abc")
substring("abc", 1, 2, 3)
substring("abc", "1")
substring(1, 1)
replace("abc", "a")
split_part("a,b", ",")
split_part("a,b", ",", "0")
pad_left("a")
pad_right("a", 3, 4)
index_of("abc")
index_of("abc", 1)
regex_match("abc", "a(b")
regex_match("abc", 1)
regex_extract("abc", "[a-")
regex_extract("abc", "(a)(b)", 3)
regex_extract("abc", "abc", 1)
regex_extract("abc", "(a)", -1)
regex_replace("abc", "*", "x")
regex_replace("abc", "a")
sales |> derive(found = regex_match(region, note))
sales |> derive(part = regex_extract(region, "(a)(b)", qty))
sales |> derive(part = regex_replace(note, region, "x"))
sales |> derive(parts = split(region, ","))
split("a,b")
split(1, ",")
split("a,b", 1)
args(1)
args() + 1
let first: int = args()[0]
read_csv<Sale>("sales.csv", delimiter = "ab")
read_csv<Sale>("sales.csv", delimiter = "")
read_csv<Sale>("sales.csv", delimiter = "\"")
read_csv<Sale>("sales.csv", delimiter = 1)
read_csv<Sale>("sales.csv", encoding = "klingon")
read_csv<Sale>("sales.csv", separator = ";")
read_csv<Sale>("sales.csv", delimiter = ";", delimiter = ",")
read_csv<Sale>("sales.csv", delimiter = ";", "x")
read_csv<Sale>(delimiter = ";")
read_csv<Sale>("a.csv", "b.csv")
read_json<Sale>("sales.json", encoding = "tis-620")
read_parquet<Sale>("sales.parquet", delimiter = ";")
write_csv(sales, "out.csv", encoding = "utf-16")
write_csv(sales, "out.csv", encoding = "nope")
write_csv(sales, "out.csv", delimiter = "::")
write_csv(sales, "out.csv", header = false)
write_csv(sales, delimiter = ";")
write_json(sales, "out.json", delimiter = ";")
