(type Sale {date: date, region: string, qty: int, price: float?})
(let sales (call read_csv <Sale> "data/sales.csv"))
(|> sales (call where (> quantity 1)))
(|> sales (call where region))
(|> sales (call select region nope))
(|> sales (call derive (x: (+ region 1))))
(|> sales (call group region) (call where (> price 1)))
(|> sales (call agg (total: (call sum region))))
(|> sales (call group region) (call agg (total: price)))
(|> sales (call take "3"))
(|> sales (call sort))
(call read_csv "x.csv")
(|> sales (call join sales (on: region)))
(|> sales (call derive (p: (+ price 1))) (call where (== p null)))
(|> sales
  (call window (order: date) (n: (call row_number)) (date: (call rank))))
(fn double(n: int) -> int (block (* n 2)))
(|> sales (call derive (d: (call double qty))))
(let n: int (|> sales (call count) (call to_string)))
(call sum 1)
(|> sales (call derive (d: (list region))))
(|> sales (call where (> price 1)) (call missing))
(let qty 5)
(|> sales (call where (> qty 1)))
