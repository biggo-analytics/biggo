(+ (call args) 1)
(let first: int (index (call args) 0))
(call read_csv <Sale> "sales.csv" (delimiter: "ab"))
(call read_csv <Sale> "sales.csv" (delimiter: ""))
(call read_csv <Sale> "sales.csv" (delimiter: "\""))
(call read_csv <Sale> "sales.csv" (delimiter: 1))
(call read_csv <Sale> "sales.csv" (encoding: "klingon"))
(call read_csv <Sale> "sales.csv" (separator: ";"))
