(type Sale {region: string, qty: int, note: string?})
(let sales (call read_csv <Sale> "sales.csv"))
(call substring "abc")
(call substring "abc" 1 2 3)
(call substring "abc" "1")
(call substring 1 1)
(call replace "abc" "a")
(call split_part "a,b" ",")
(call split_part "a,b" "," "0")
(call pad_left "a")
(call pad_right "a" 3 4)
(call index_of "abc")
(call index_of "abc" 1)
(call regex_match "abc" "a(b")
(call regex_match "abc" 1)
(call regex_extract "abc" "[a-")
(call regex_extract "abc" "(a)(b)" 3)
(call regex_extract "abc" "abc" 1)
(call regex_extract "abc" "(a)" (- 1))
(call regex_replace "abc" "*" "x")
(call regex_replace "abc" "a")
(|> sales (call derive (found: (call regex_match region note))))
(|> sales (call derive (part: (call regex_extract region "(a)(b)" qty))))
(|> sales (call derive (part: (call regex_replace note region "x"))))
(|> sales (call derive (parts: (call split region ","))))
(call split "a,b")
(call split 1 ",")
(call split "a,b" 1)
