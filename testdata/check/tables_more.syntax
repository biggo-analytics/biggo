(type Sale {region: string, qty: int, price: float?, count: int})
(let sales (call read_csv <Sale> "sales.csv"))
(let other (call read_csv <{region: string, qty: float}> "other.csv"))
(|> sales (call count_by))
(|> sales (call count_by nothing))
(|> sales (call count_by count))
(|> sales (call count_by (+ qty 1)))
(|> sales (call drop_nulls nothing))
(|> sales (call drop_nulls (price: 1)))
(|> sales (call fill_nulls))
(|> sales (call fill_nulls price))
(|> sales (call fill_nulls (nothing: 1)))
(|> sales (call fill_nulls (price: "none")))
(|> sales (call fill_nulls (price: 1) (price: 2)))
(|> sales (call fill_nulls (price: qty)))
(call columns sales 1)
(call columns 1)
(call intersect sales)
(call intersect sales other)
(call except sales 1)
(call union sales other)
(|> sales (call join other (how: "cross") (on: region)))
(|> sales (call join sales (how: "cross")))
(|> sales (call join other (how: "sideways")))
(|> sales (call tail))
(|> sales (call tail "2"))
(|> sales (call sample))
(|> sales (call sample 2 (fraction: 0.5)))
(|> sales (call sample (fraction: 1.5)))
(|> sales (call sample 2 (seed: "x")))
(|> sales (call sample 2 (weight: 1)))
(|> sales (call sample "some"))
(|> sales (call sort qty (nulls: "middle")))
(|> sales (call sort qty (order: "desc")))
(|> sales (call sort (nulls: "first")))
(call hash)
(call hash 1 2 3)
(call hash 1 "seed")
(|> sales (call derive (h: (call hash region qty))))
