(type Row {id: int, name: string})
(let t (call from_rows (list (record (id: 1) (name: "a")))))
(call read_excel <Row> "a.xlsx" (sheet: 2))
(call read_excel <Row> "a.xlsx" (range: 5))
(call read_excel <Row> "a.xlsx" (delimiter: ";"))
(call read_excel <Row> "a.xlsx" "Sheet1")
(call read_excel <Row> "a.xlsx" (skip: (- 2)))
(call read_excel <Row> "a.xlsx" (header: "no"))
(call read_excel <Row> "a.xlsx" (file_name: "id"))
(call read_excel "a.xlsx")
(call read_excel <Row>)
(call write_excel t)
(call write_excel t "a.xlsx" "Sheet1")
(call write_excel t "a.xlsx" (sheet: 1))
(call write_excel t "a.xlsx" (range: "A1:B2"))
(call write_excel "a.xlsx" t)
