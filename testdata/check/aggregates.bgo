// Mistakes in aggregates.
type Sale = { region: string, qty: int, price: float?, sold: bool }
let sales = read_csv<Sale>("sales.csv")

sales |> agg(a = quantile(qty))
sales |> agg(a = quantile(qty, 1.5))
sales |> agg(a = quantile(qty, -0.1))
sales |> agg(a = quantile(qty, "half"))
sales |> agg(a = quantile(qty, price))
sales |> agg(a = quantile(region, 0.5))
sales |> agg(a = quantile(qty, 0.5, 0.9))
sales |> agg(a = variance(region))
sales |> agg(a = stddev_pop(sold))
sales |> agg(a = product(region))
sales |> agg(a = string_agg(region))
sales |> agg(a = string_agg(qty, ","))
sales |> agg(a = string_agg(region, 1))
sales |> agg(a = string_agg(region, region))
sales |> agg(a = arg_max(region))
sales |> agg(a = arg_max(region, sold))
sales |> agg(a = arg_min(region, qty, price))
sales |> agg(a = count_if(qty))
sales |> agg(a = count_if())
sales |> agg(a = count_if(sold, sold))
sales |> agg(a = any(region))
sales |> agg(a = all(qty + 1))
sales |> agg(a = count_null())
sales |> agg(a = weighted_mean(price))
sales |> agg(a = weighted_mean(price, region))
sales |> agg(a = weighted_mean(region, qty))
sales |> derive(a = count_if(sold))
sales |> where(any(sold))
sales |> window(a = quantile(qty, 0.5))
sales |> window(a = string_agg(region, ","))
sales |> window(a = arg_max(region, qty))
count_if(true)
variance(1)
