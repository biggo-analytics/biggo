(type Row {id: int, name: string, n: int})
(call read_csv <Row> "a.csv" (header: 1))
(call read_csv <Row> "a.csv" (skip: "3"))
(call read_csv <Row> "a.csv" (skip: (- 1)))
(call read_csv <Row> "a.csv" (nulls: "NA"))
(call read_csv <Row> "a.csv" (nulls: (list 1 2)))
(call read_csv <Row> "a.csv" (file_name: "source"))
(call read_csv <Row> "a.csv" (file_name: "n"))
(let column "name")
(call read_csv <Row> "a.csv" (file_name: column))
(call read_csv <Row> "a.csv" (header: false) (header: true))
(call read_csv <Row> "a.csv" (sheet: 2))
(call read_csv <Row> "a.csv" "b.csv")
(call read_json <Row> "a.json" (header: false))
(call read_json <Row> "a.json" (file_name: "id"))
(call read_parquet <Row> "a.parquet" (skip: 1))
(call read_parquet <Row>)
(call read_sql <Row> "a.db" "select 1" (file_name: "name"))
(call read_csv <{file: string}> "a.csv" (file_name: "file"))
(call write_csv
  (call from_rows (list (record (a: 1))))
  "out.csv"
  (header: false))
(call env)
(call env 1)
(call env "A" "B")
(let home: string (call env "HOME"))
