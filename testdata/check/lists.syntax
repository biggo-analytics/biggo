(let xs (list 1 2 3))
(let words (list "a" "b"))
(let rows (list (record (n: 1)) (record (n: 2))))
(let m (map ("a" 1)))
(call sort rows)
(call sort xs true)
(call sort xs (reverse: true))
(call sort xs (desc: 1))
(call sort_by xs)
(call sort_by xs 5)
(call sort_by rows (lambda (r) (block r)))
(call sort_by xs (lambda (a, b) (block a)))
(call sum words)
(call mean words)
(call min rows)
(call sum xs 1)
(call contains xs "a")
(call contains rows (record (n: 1)))
(call index_of xs)
(call join xs ",")
(call join words)
(call join words 1)
(call reverse xs 1)
(call distinct rows)
(call take xs)
(call take xs "2")
(call skip xs 1.5)
(call slice xs 1)
(call first xs 1)
(call flatten xs)
(call any xs)
(call any xs (lambda (x) (block x)))
(call all xs 5)
(call find xs (lambda (x) (block "yes")))
(call remove xs 1)
(call remove m 1)
(call merge m xs)
(call merge m (map ("a" "one")))
(call entries xs)
(call sort m)
(call sum m)
(call slice 5 1 2)
(call flatten)
(call entries)
(call count xs)
(call count xs (lambda (x) (block x)))
(call count m (lambda (x) (block true)))
(call sort_by (lambda (x) (block x)))
