// Mistakes in the newer table operations.
type Sale = { region: string, qty: int, price: float?, count: int }
let sales = read_csv<Sale>("sales.csv")
let other = read_csv<{ region: string, qty: float }>("other.csv")

sales |> count_by()
sales |> count_by(nothing)
sales |> count_by(count)
sales |> count_by(qty + 1)
sales |> drop_nulls(nothing)
sales |> drop_nulls(price = 1)
sales |> fill_nulls()
sales |> fill_nulls(price)
sales |> fill_nulls(nothing = 1)
sales |> fill_nulls(price = "none")
sales |> fill_nulls(price = 1, price = 2)
sales |> fill_nulls(price = qty)
columns(sales, 1)
columns(1)
intersect(sales)
intersect(sales, other)
except(sales, 1)
union(sales, other)
sales |> join(other, how = "cross", on = region)
sales |> join(sales, how = "cross")
sales |> join(other, how = "sideways")
sales |> tail()
sales |> tail("2")
sales |> sample()
sales |> sample(2, fraction = 0.5)
sales |> sample(fraction = 1.5)
sales |> sample(2, seed = "x")
sales |> sample(2, weight = 1)
sales |> sample("some")
sales |> sort(qty, nulls = "middle")
sales |> sort(qty, order = "desc")
sales |> sort(nulls = "first")
hash()
hash(1, 2, 3)
hash(1, "seed")
sales |> derive(h = hash(region, qty))
