(type Sale {region: string, qty: int, price: float?})
(let sales (call read_csv <Sale> "sales.csv"))
(call format_number 1)
(call format_number "1" 2)
(call format_number 1 2.5)
(call format_number 1 (- 1))
(call format_number 1 16)
(call format_number 1 2 3)
(call format_number 1 2 "," ".")
(|> sales (call derive (a: (call format_number price qty))))
(|> sales (call derive (a: (call format_number price 2 region))))
(call format_percent "half")
(call format_percent 0.5 99)
(call trim_left)
(call trim_left 1)
(call trim "a" 1)
(call trim "a" "b" "c")
(call left "abc")
(call left "abc" "2")
(call right 5 2)
(call repeat "a")
(call repeat "a" 1.5)
(call reverse 123)
(call title)
(call concat)
(call concat (list 1))
(call concat sales)
(call like "abc")
(call like "abc" 5)
(call like "abc" "oops\\")
(|> sales (call where (call like region region)))
(call regex_count "abc")
(call regex_count "abc" "a(")
(|> sales (call derive (n: (call regex_count region region))))
(call sha256 1)
(call md5)
