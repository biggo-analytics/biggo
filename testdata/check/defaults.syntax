(let base 10)
(fn limit() -> int (block 5))
(fn a(n: int) -> int (default n "ten") (block n))
(fn b(n: int) -> int (default n base) (block n))
(fn c(n: int) -> int (default n (call limit)) (block n))
(fn d(n: int) -> int (default n (+ 1 1)) (block n))
(fn e(first: int, second: int) -> int
  (default first 1)
  (block (+ first second)))
(fn f(xs: list<int>) -> int (default xs (list 1 "two")) (block (call len xs)))
(fn g(n: int?, m: float) -> float (default n null) (default m 2) (block m))
(fn h(name: string, times: int) -> string
  (default times 2)
  (block (call repeat name times)))
(call h)
(call h "a" 1 2)
(call h "a" (times: "3"))
(call h "a" (count: 3))
(call g 1 2.0 3)
(let held h)
(call held "a")
