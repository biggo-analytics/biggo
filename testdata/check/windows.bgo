// Mistakes in window functions.
type Visit = { day: date, site: string, visits: int?, open: bool }
let log = read_csv<Visit>("visits.csv")

log |> window(a = dense_rank(visits))
log |> window(a = percent_rank(1))
log |> window(a = ntile())
log |> window(a = ntile(0))
log |> window(a = ntile(visits))
log |> window(a = ntile(2, 3))
log |> window(a = cum_count(visits, 2))
log |> window(a = cum_min())
log |> window(a = cum_max(open))
log |> window(a = cum_mean(site))
log |> window(a = moving_sum(visits))
log |> window(a = moving_sum(site, 2))
log |> window(a = moving_min(visits, 0))
log |> window(a = moving_max(visits, visits))
log |> window(a = diff(site))
log |> window(a = diff(visits, 1.5))
log |> window(a = pct_change(day))
log |> window(a = pct_change())
log |> window(a = fill_forward())
log |> window(a = fill_backward(visits, 1))
log |> derive(a = diff(visits))
log |> agg(a = cum_max(visits))
diff(1)
