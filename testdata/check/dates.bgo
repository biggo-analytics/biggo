// Mistakes in date functions.
type Event = { day: date, at: datetime, text: string, n: int }
let events = read_csv<Event>("events.csv")

today(1)
now("x")
weekday("monday")
weekday(1)
quarter()
start_of_month(5)
add_days(@2026-01-01, 1.5)
add_months(@2026-01-01)
add_years("2026", 1)
days_between(@2026-01-01, 5)
months_between(@2026-01-01)
total_days(5)
total_hours(@2026-01-01)
make_date(2026, 1)
make_date(2026, "1", 1)
make_datetime(2026, 1, 1)
format_date(@2026-01-01)
format_date(@2026-01-01, "%Q")
format_date(@2026-01-01, "%Y %Z")
format_date("2026-01-01", "%Y")
format_date(@2026-01-01, "%Y", era = "be")
format_date(@2026-01-01, "%Y", calendar = "buddhist")
format_date(@2026-01-01, "%Y", "buddhist")
parse_date("2026", 2026)
parse_date(2026, "%Y")
parse_datetime("2026")
try_parse_date("2026", "%")
events |> derive(shown = format_date(day, text))
events |> derive(read = parse_date(text, "%Y", era = text))
time_bucket(@2026-01-01, 15)
time_bucket("2026", minutes(15))
to_unix(5)
from_unix("5")
fiscal_year(@2026-01-01)
fiscal_year(@2026-01-01, "10")
buddhist_year(2569)
weekday(@2026-01-01, era = "buddhist")
