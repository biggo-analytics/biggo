(type Priced table<{product: string, qty: int, price: float?}>)
(fn revenue(t: Priced) -> table<{product: string, revenue: float}>
  (block
    (|> t
      (call group product)
      (call agg (revenue: (call sum (* (call to_float qty) (?? price 0.0)))))
      (call sort product))))
(fn units(t: table<{qty: int}>) -> int
  (block
    (. (index (call to_rows (|> t (call agg (total: (call sum qty))))) 0) total)))
(fn large(t: table<{qty: int}>) -> table<{qty: int}>
  (block (|> t (call where (> qty 3)))))
(let sales
  (call from_rows
    (list
      (record
        (day: @2026-01-05)
        (region: "north")
        (product: "widget")
        (qty: 10)
        (price: 2.5))
      (record
        (day: @2026-01-06)
        (region: "south")
        (product: "gadget")
        (qty: 3)
        (price: 10.0))
      (record
        (day: @2026-01-07)
        (region: "north")
        (product: "widget")
        (qty: 5)
        (price: 3.0)))))
(let returns
  (|>
    (call from_rows
      (list (record (product: "widget") (qty: 1) (reason: "broken"))))
    (call derive (price: (if (> qty 5) (block 1.0) (block null))))))
(call print (call revenue sales))
(call print (|> returns (call revenue)))
(call print
  (call units sales)
  (call units returns)
  (|> sales (call where (== region "north")) (call units)))
(call print (call revenue (|> sales (call select price region qty product))))
(let slim: table<{product: string, qty: int}> sales)
(call print slim)
(fn north(t: table<{region: string, qty: int, product: string}>) -> table<{product: string, qty: int}>
  (block (|> t (call where (== region "north")))))
(call print (call north sales))
(call explain (|> (call large sales) (call agg (total: (call sum qty)))))
