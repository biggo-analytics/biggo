// An expression that can fail is only evaluated for the rows that reach it, as in ordinary
// code: no division happens where `qty` is zero.

type Sale = { product: string, qty: int }

let sales = read_csv<Sale>("data/sales.csv")

sales
  |> derive(
    per_unit = if qty != 0 { 100 % qty } else { -1 },
    divides = qty != 0 and 100 % qty == 0,
    fallback = (if qty > 4 { qty } else { null }) ?? 100 % (qty + 1),
  )
  |> take(4)
  |> print()

// Without the guard the query fails, and the error points at the statement that ran it.
sales |> derive(per_unit = 100 % qty) |> print()
