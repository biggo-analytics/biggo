(call print
  (call substring "hello world" 6)
  (call substring "hello" 1 3)
  (call substring "hello" (- 3)))
(call print
  (call substring "hello" (- 3) 2)
  (+ (call substring "hello" 9) "|")
  (call substring "hello" 3 99))
(call print
  (call substring "größe" 2 2)
  (call substring "ราคา" 1 2)
  (+ (call substring "hello" 2 0) "|"))
(call print
  (call replace "a-b-c" "-" "+")
  (call replace "aaa" "a" "")
  (call replace "abc" "" "x"))
(call print
  (call split "a,b,,c" ",")
  (call split "one" ",")
  (call split "a::b" "::")
  (call split "abc" ""))
(call print
  (call split_part "a,b,c" "," 0)
  (call split_part "a,b,c" "," (- 1))
  (call split_part "a,b,c" "," 3))
(call print
  (call pad_left "7" 3 "0")
  (+ (call pad_right "ab" 5) "|")
  (call pad_left "hello" 3)
  (call pad_left "x" 6 "ab"))
(call print
  (call index_of "hello" "l")
  (call index_of "hello" "z")
  (call index_of "größe" "ß")
  (call index_of "a" ""))
(call print
  (call regex_match "order-123" "[0-9]+")
  (call regex_match "order-123" "^[0-9]+$"))
(call print
  (call regex_extract "order-123" "[0-9]+")
  (call regex_extract "order-123" "([a-z]+)-([0-9]+)" 1))
(call print
  (call regex_extract "no digits" "[0-9]+")
  (call regex_extract "ab" "(a)|(b)" 2))
(call print (call regex_replace "2026-01-05" "(\\d+)-(\\d+)-(\\d+)" "$3/$2/$1"))
(call print
  (call regex_replace "a1b22c" "[0-9]+" "#")
  (call regex_replace "price: $5" "\\$" "USD "))
(let none: string? null)
(let no_int: int? null)
(call print
  (call substring none 1)
  (call substring "abc" no_int)
  (call replace "abc" "a" none))
(call print
  (call split_part none "," 0)
  (call pad_left "a" no_int)
  (call index_of none "a"))
(call print
  (call regex_match none "a")
  (call regex_match "a" none)
  (call regex_extract "a" none)
  (call regex_replace none "a" "b"))
(let parts (call split "2026-01-05" "-"))
(call print
  (call len parts)
  (call map parts (lambda (part) (block (call to_int part)))))
(call print
  (call fold
    (call split "3 4 5" " ")
    0
    (lambda (sum, part) (block (+ sum (call to_int part))))))
(let codes
  (call from_rows
    (list
      (record (code: "TH-001-a") (n: 1) (sep: "-"))
      (record (code: "US-22-bb") (n: 2) (sep: "2"))
      (record (code: null) (n: 3) (sep: "-"))
      (record (code: "plain") (n: 0) (sep: "")))))
(|> codes
  (call derive
    (country: (call split_part code "-" 0))
    (last: (call split_part code sep (- 1)))
    (number: (call to_int (call regex_extract code "-([0-9]+)-" 1)))
    (padded: (call pad_left (call to_string n) 3 "0")))
  (call print))
(|> codes
  (call select code
    (tail: (call substring code (- 2)))
    (head: (call substring code 0 n))
    (thai: (call regex_match code "^TH"))
    (dash: (call index_of code sep))
    (colon: (call regex_replace code "^([A-Z]+)-" "$1:"))
    (swapped: (call replace code sep "/"))
    (wide: (+ (call pad_right code 9 ".") "|")))
  (call print))
(let wanted (+ (+ (+ (+ "^(" "TH") "|") "US") ")"))
(call print (|> codes (call where (call regex_match code wanted)) (call count)))
(call print
  (|> codes
    (call group (country: (call split_part code "-" 0)))
    (call agg (rows: (call count)))))
(let broken (+ "a(" "b"))
(call print (call regex_match "ab" broken))
